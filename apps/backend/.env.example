# ==========================================
# CẤU HÌNH CHO LITE DEV KIT (KHỚP VỚI SEED)
# ==========================================

# 1. Tắt OpenAI Embedding (để không dùng 1536 dim)
USE_OPENAI_EMBEDDING=False

# 2. Bật Local/FastEmbed (để dùng 384 dim)
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"

# 3. Trỏ đúng Qdrant Collection vừa seed
QDRANT_COLLECTION_NAME="gov_knowledge"

# 4. Trỏ đúng Postgres Local
DATABASE_URL="postgresql://dev:dev@localhost:5432/rag_db"

# ==========================================
# CẤU HÌNH LLM (chọn 1 trong 2 phương án)
# ==========================================

# --- PHƯƠNG ÁN A: OpenAI (trả phí, cần thẻ Visa) ---
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=                          # Để trống nếu dùng OpenAI thật
# OPENAI_MODEL_NAME=gpt-4o-mini             # Rẻ nhất của OpenAI

# --- PHƯƠNG ÁN B: Groq (MIỄN PHÍ, lấy key tại console.groq.com) ---
# OPENAI_API_KEY=gsk_xxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_NAME=llama-3.3-70b-versatile

# --- PHƯƠNG ÁN C: Ollama Local (chạy trên máy, không cần internet) ---
# OPENAI_API_KEY=ollama                     # Bất kỳ chuỗi nào cũng được
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL_NAME=llama3.2               # Tên model đã pull về

# ==========================================
# CẤU HÌNH WEB SEARCH (tuỳ chọn)
# ==========================================
# DuckDuckGo miễn phí, sẵn sàng dùng ngay (không cần key)
# Nếu muốn chất lượng cao hơn thì lấy key Tavily tại tavily.com (1000 req/tháng free)
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxx
