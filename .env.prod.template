# Production Environment Configuration Template
# Copy this to .env.prod and fill in secrets

# --- 1. Runtime Mode (Fail-Closed) ---
# MUST be prod for production deployment
ENV_MODE=prod
# MUST be false to prevent test bypasses
CI_MODE=false

# --- 2. Database Configuration ---
# Persistence required (Docker Volumes used in compose)
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=
POSTGRES_DB=govai_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL constructed by backend, but can be overridden:
DB_URL=postgresql+asyncpg://prod_user:PASSWORD@postgres:5432/govai_prod

# --- 3. Vector Database (Qdrant) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=gov_knowledge_prod
QDRANT_READONLY_API_KEY=
QDRANT_WRITE_API_KEY=

# --- 4. Caching (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- 5. Security & Auth ---
# JSON object mapping API keys to claims. REQUIRED.
# Format: {"key": {"role": "...", "tenant_id": "...", "allowed_agents": [...], "security_level": N}}
API_KEYS_JSON='{}'

# STRICTLY disable default tenant access in production
ALLOW_DEFAULT_TENANT=false

# --- 6. LLM Provider ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_BACKEND=local
EMBED_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2

# --- 7. Domain ---
# Used by Caddy for TLS
DOMAIN_NAME=localhost
