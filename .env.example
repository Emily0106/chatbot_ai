# =============================================================================
# Gov-AI Backend - Environment Configuration Template
# =============================================================================
# This is the canonical template for all environment configurations.
# Copy this file to .env (dev), .env.staging, or .env.production and fill in
# real values. NEVER commit files with real secrets to git!
#
# For staging/production deployment, see docs/STAGING_RUNBOOK.md and
# docs/SECRETS_GUIDE.md
# =============================================================================

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Options: "dev", "ci", "staging", "prod"
# - dev: Development (relaxed validation, dev-key fallback allowed)
# - ci: Continuous Integration (uses dummy/mock values)
# - staging: Staging (enforces C0 validation, requires real secrets)
# - prod: Production (strictest validation)
ENV_MODE=dev

# CI Mode (only for automated testing, MUST be false in staging/prod)
CI_MODE=false

# =============================================================================
# SECURITY (REQUIRED in staging/prod)
# =============================================================================

# API Keys: JSON mapping of API keys to tenant IDs
# Format: {"<api-key-string>": "<tenant-id>", ...}
# Example: {"dev-key-123":"tenant-dev","my-secret-key-abc":"tenant-1"}
# Generate strong random keys for staging/prod (see docs/SECRETS_GUIDE.md)
API_KEYS_JSON={"dev-key-123":"default"}

# Default Tenant Access (MUST be false in staging/prod for security)
# Only set to true in dev for testing null-scope data
ALLOW_DEFAULT_TENANT=false

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (SQLAlchemy format with asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/database
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# =============================================================================
# VECTOR DATABASE (Qdrant)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gov_knowledge
QDRANT_API_KEY=
QDRANT_READONLY_API_KEY=
QDRANT_WRITE_API_KEY=

# Vector dimension (default 768 for all-MiniLM-L6-v2)
VECTOR_DIM=768

# =============================================================================
# CACHE (Redis)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM & EMBEDDINGS
# =============================================================================

# OpenAI API Key (REQUIRED in staging/prod if using OpenAI for LLM or embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Configuration
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# OpenAI Embedding Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_EMBEDDING_DIMENSIONS=1536

# Embedding Backend: "local" or "openai"
# - local: Uses local sentence-transformers model (no API cost)
# - openai: Uses OpenAI embedding API (requires OPENAI_API_KEY)
EMBEDDING_BACKEND=local

# Local Embedding Model Path
# Format: either local path or HuggingFace model ID
# Examples: ./models/all-MiniLM-L6-v2, sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2

# Embedding Device: "cpu", "cuda", or "mps" (Mac)
EMBEDDING_DEVICE=cpu

# Gate G0: Lock Identity (version identifier for embedding model)
EMBEDDING_MODEL_ID=pilot-embedding-v1

# SQL LLM Model (for SQL generation tasks)
SQL_LLM_MODEL=gpt-4o-mini

# =============================================================================
# EXTERNAL APIS
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Hybrid/Eco Retrieval
RETRIEVAL_MODE=auto
RETRIEVAL_DEADLINE_MS=1500

# Reranking
RERANK_ENABLED=false
RERANK_DEVICE=cpu
RERANK_TIMEOUT_S=0.35
RERANK_TRY_ACQUIRE=true
RERANK_BREAKER_FAILS=5
RERANK_BREAKER_COOLDOWN_S=60.0

# SQL Core
ENABLE_NEW_SQL_CORE=true
SQL_SHADOW_MODE=false

# Temporary Documents
ENABLE_TEMP_DOCS=true
TEMP_DOC_TTL=3600

# Ingestion Service
INGESTION_BASE_URL=http://localhost:8010

# Router (Fast Lane)
ENABLE_FAST_LANE=false
FAST_TOP_K=20
FAST_PREFETCH_K=40
FAST_SKIP_RERANK=true

# Streaming
ENABLE_STREAMING_CHAT=false
STREAM_HEARTBEAT_S=15
STREAM_TIMEOUT_S=60

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_RPS=2.0
RATE_LIMIT_BURST=6
MAX_INFLIGHT_PER_TENANT=8
MAX_STREAMS_PER_TENANT=3
RATE_LIMIT_REDIS_PREFIX=govai:rl
RATE_LIMIT_REDIS_TIMEOUT_S=0.2

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PREFIX=/api

# =============================================================================
# STORAGE (S3/MinIO - for ingestion service)
# =============================================================================
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ingestion

# =============================================================================
# NOTES
# =============================================================================
# - For staging/prod deployment, see docs/STAGING_RUNBOOK.md
# - For secrets management guide, see docs/SECRETS_GUIDE.md
# - Run preflight validation: python3 scripts/preflight_env.py
# - Runtime validation (C0) runs automatically on app startup
