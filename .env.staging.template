# Staging Environment Configuration Template
# Copy this to .env.staging and fill in real values
# NEVER commit .env.staging to git!

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENV_MODE=staging
CI_MODE=false

# =============================================================================
# SECURITY (REQUIRED - Runtime validation will fail without these)
# =============================================================================

# API Keys: JSON mapping of API keys to tenant IDs
# Format: {"<api-key>": "<tenant-id>", ...}
# Generate strong random keys for staging
API_KEYS_JSON='{"staging-key-CHANGE-ME-1":"tenant-staging-1","staging-key-CHANGE-ME-2":"tenant-staging-2"}'

# Default tenant access (must be false in staging/prod)
ALLOW_DEFAULT_TENANT=false

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=staging
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=govai_staging
DB_URL=postgresql+asyncpg://staging:CHANGE-ME-strong-password@postgres:5432/govai_staging

# =============================================================================
# VECTOR DATABASE
# =============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=gov_knowledge
QDRANT_READONLY_API_KEY=
QDRANT_WRITE_API_KEY=

# =============================================================================
# CACHE
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# LLM & EMBEDDINGS
# =============================================================================

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=sk-CHANGE-ME-your-openai-key

# Embedding backend: "local" or "openai"
EMBEDDING_BACKEND=local
EMBED_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# OpenAI settings (optional)
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_RATE_LIMITING=true
ENABLE_STREAMING_CHAT=true
ENABLE_NEW_SQL_CORE=true
RERANK_ENABLED=false

# =============================================================================
# OPTIONAL: Override default ports
# =============================================================================
# BACKEND_PORT=8000
# POSTGRES_PORT=5432
# QDRANT_PORT=6333
# REDIS_PORT=6379
