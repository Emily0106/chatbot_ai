          "expr": "sum(rate(govai_chat_requests_total{agent_id=~\"$agent_id\", lane=~\"$lane\", stream=~\"$stream\", status!=\"ok\"}[5m])) / sum(rate(govai_chat_requests_total{agent_id=~\"$agent_id\", lane=~\"$lane\", stream=~\"$stream\"}[5m]))",
